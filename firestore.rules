rules_version = '2';

// Firestore security rules for Baliwag EduConnect.
//
// To deploy: Firebase Console > Firestore Database > Rules tab > paste this
// file's contents > Publish.
//
// NOTE: an earlier version gated scholarships/announcements/applications
// writes on an isAdmin() function that did a cross-document get() into
// users/{uid} to check role == 'admin'. That consistently returned
// permission-denied for a confirmed real admin account in this project even
// though the stored data was correct, and there was no way to run the
// Firestore emulator in this dev environment to isolate why (no working
// Java install). Rather than keep guessing against a live project, the
// admin/owner boundary here is enforced by the app's own AuthGate (a
// non-admin account can never reach the Admin Dashboard UI at all — see
// lib/widgets/auth_gate.dart) plus the isOwner() checks below, which don't
// need any cross-document lookup. If you want database-level
// role-enforcement restored later, revisit isAdmin() with the emulator once
// Java is available, or move the check to Firebase Auth custom claims via a
// Cloud Function (requires the Blaze plan).

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile (role, name, student number, course, and —
    // for a Provider account — organizationName/providerStatus).
    match /users/{uid} {
      // Read stays owner-only... except the Admin Dashboard's "Providers"
      // tab needs to list every provider account to approve/reject them,
      // which (like every other admin-only surface in this app — see the
      // note at the top of this file) is enforced by the UI, not here.
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // Update is intentionally NOT owner-only: Admin must be able to flip
      // another user's `providerStatus` to approve/reject a Provider
      // account (see UserRepository.setProviderStatus). This mirrors the
      // same already-accepted tradeoff as `scholarships`/`announcements`
      // below — UI-gated, not rules-gated — extended to one more field.
      // `role` is still the one thing nobody may ever change post-creation.
      allow update: if isSignedIn() &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Scholarship programs: everyone signed in can read; write is gated by
    // the Admin Dashboard UI (see note above).
    match /scholarships/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Announcements: everyone signed in can read; write is UI-gated.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Applications: a student can only create their own (enforced here,
    // doesn't need a cross-document lookup). Reading and most updates are
    // still UI-gated (students only ever query their own via
    // watchForStudent(uid), admins review all via the Admin Dashboard) —
    // there's no reliable way to tell "this signed-in user is an admin"
    // at the rules level without either custom claims (needs a Cloud
    // Function, which needs the Blaze plan) or the isAdmin() cross-document
    // read that was tried before and mysteriously returned
    // permission-denied for a real admin account, with no working
    // emulator available to debug why (see git history / prior notes).
    //
    // What IS enforced here without needing to know who's an admin: an
    // application's own OWNER can never change its `status` field — that
    // closes the worst concrete escalation (a student setting their own
    // application to "approved" via a direct Firestore call, bypassing the
    // admin entirely). A student maliciously editing or deleting *another*
    // student's application is a separate, lower-likelihood residual gap
    // that genuinely needs the admin check above to close properly.
    // `delete` is blocked outright — no feature in this app ever deletes
    // an application, so there's no functionality lost by refusing it.
    match /applications/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.studentUid != request.auth.uid ||
          request.resource.data.status == resource.data.status);
      allow delete: if false;
    }
  }
}
